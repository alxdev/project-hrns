# Choose: openai, anthropic, or local
HARNESS_PROVIDER=openai

# Set the key for the selected provider.
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional MCP authentication credentials. Add only the variables required by
# an MCP server registered in the project-local mcp.json.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# EXAMPLE_MCP_TOKEN=

# Optional settings
# HARNESS_MODEL=gpt-4o-mini
# HARNESS_WORKING_DIR=.
log_prompt_sent_to_model=false
